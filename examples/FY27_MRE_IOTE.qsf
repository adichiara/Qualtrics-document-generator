341","QuestionIDFromLocator":"QID19789341","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"QuestionText_Unsafe":"How many times have you been deployed?","DataExportTag":"Q2.9","QuestionID":"QID19789342"}},{"SurveyID":"SV_1AL8VLzf3hHK0dw","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Intro","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"DataExportTag":"Q1.1","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Intro","QuestionID":"QID2","QuestionText":"<img height=\"104\" src=\"https:\/\/ccdcsoldiercenter.gov1.qualtrics.com\/CP\/Graphic.php?IM=IM_ADCulW9UDuYHD1y\" style=\"width: 300px; height: 104px;\" width=\"300\"><br>\n<br>\n<br>\n<strong>Thank you for supporting this evaluation of the Meal, Ready-to-Eat (MRE) during your&nbsp;recent training exercise.&nbsp;<\/strong><br>\n<br>\nPlease provide feedback on this survey about your use of the MRE during training, your level of satisfaction with the ration, and your use of MRE items.&nbsp;<br>\n&nbsp;\n<div style=\"text-align: left;\">The feedback you provide will directly impact future fielded versions of the MRE.&nbsp;<br>\n<br>\n&nbsp;<\/div>\n\n<div style=\"text-align: center;\">Your input is very appreciated.<br>\nThank you for your support!<br>\n<span style=\"color:#999999;\">U.S. Army DEVCOM Soldier Center<\/span><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"color:#000000;\">POC:<br>\nAdam DiChiara,&nbsp;<\/span><a href=\"mailto:adam.j.dichiara.civ@army.mil?subject=MRE%20Evaluation%20Survey\"><span style=\"color:#000000;\">adam.j.dichiara.civ@army.mil<\/span><\/a><\/div>","QuestionText_Unsafe":"<img height=\"104\" src=\"https:\/\/ccdcsoldiercenter.gov1.qualtrics.com\/CP\/Graphic.php?IM=IM_ADCulW9UDuYHD1y\