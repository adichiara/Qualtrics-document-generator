{
  "fonts": {
    "family": "Arial",
    "title_size": 17,
    "section_size": 12,
    "preserve_rich_text": true
  },
  "sections": {
    "show_block_names": false
  },
  "page": {
    "paper_size": "letter",
    "orientation": "portrait",
    "margin_top_inches": 0.7,
    "margin_bottom_inches": 0.7,
    "margin_left_inches": 0.8,
    "margin_right_inches": 0.8
  },
  "questions": {
    "font_size": 12,
    "bold": false,
    "numbering": "sequential",
    "blank_lines_before": 2,
    "line_spacing": null,
    "space_after_pt": 5,
    "page_break_before": false
  },
  "responses": {
    "font_size": 11,
    "minimum_font_size": 8,
    "symbol_size": 11,
    "single_mark": "\u25ef",
    "multiple_mark": "\u2610",
    "layout": "auto",
    "multiple_columns_above": 10,
    "max_columns": 2,
    "short_label_max_chars": 30,
    "dropdown_write_in_at": 12,
    "row_height_inches": 0.25,
    "field_row_height_inches": 0.34,
    "form_preferred_row_height_inches": 0.45,
    "large_list_banded_rows": true,
    "indent_inches": 0.5
  },
  "tables": {
    "line_spacing": 1,
    "cell_padding_inches": null,
    "banded_rows": false,
    "band_color": "#F7F7F7",
    "borders": {
      "enabled": false,
      "weight_pt": 0.5,
      "color": "#D9D9D9"
    },
    "row_bottom_border": {
      "enabled": false,
      "weight_pt": 0.5,
      "color": "#CCCCCC"
    }
  },
  "matrix": {
    "header_rotation": "auto",
    "rotate_at_columns": 5,
    "statement_font_size": null,
    "minimum_statement_font_size": null,
    "header_font_size": 10,
    "minimum_header_font_size": 9,
    "header_bold": true,
    "header_max_height_inches": null,
    "statement_column_width_inches": null,
    "preferred_row_height_inches": null,
    "minimum_row_height_inches": 0.2,
    "maximum_row_height_inches": 0.45,
    "line_spacing": 1.1,
    "cell_padding_inches": 0.009722222222222222,
    "banded_rows": true,
    "band_color": "#F7F7F7",
    "header_color": "#EAEAEA",
    "row_bottom_border": {
      "enabled": false,
      "weight_pt": 0.5,
      "color": "#CCCCCC"
    }
  },
  "write_in": {
    "inline_short_answers": true,
    "inline_prompt_max_chars": 110,
    "small_underscore_count": 20,
    "large_lines": 3,
    "large_line_spacing": 1.5,
    "text_lines": 3,
    "line_height_inches": 0.3
  },
  "pagination": {
    "new_page_per_block": false,
    "keep_questions_together": true,
    "new_page_for_large_matrices": true,
    "large_matrix_min_rows": 8,
    "large_matrix_min_columns": 9,
    "large_matrix_min_height_inches": 4.5
  },
  "question_overrides": {}
}
